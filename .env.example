# Variables d'environnement Hotavis
# Copiez ce fichier en .env et renseignez les valeurs.
#
# En production (Vercel) : configurez ces mêmes variables dans
#   Vercel Dashboard → Project → Settings → Environment Variables.
# En dev local : elles sont lues automatiquement depuis .env par Vite/Nitro.

# ─── Supabase (obligatoire, déjà publiques côté client) ──────────────
SUPABASE_PROJECT_ID="votre-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://votre-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"   # SERVEUR ONLY — ne jamais exposer côté client

# ─── Base de données (pour le script scripts/setup-db.mjs uniquement) ──
# Connection string PostgreSQL directe — Supabase Dashboard → Project Settings →
# Database → Connection string → URI. Uniquement pour exécuter le setup SQL.
DATABASE_URL="postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.votre-project-id.supabase.co:5432/postgres"
# Versions VITE_* (injectées dans le bundle client via import.meta.env)
VITE_SUPABASE_PROJECT_ID="votre-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://votre-project-id.supabase.co"

# ─── Stripe (paiement) ───────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ─── Resend (emails transactionnels) ────────────────────────────────
RESEND_API_KEY="re_xxx"

# ─── Cron (sécurise /api/public/cron-reminders) ─────────────────────
CRON_SECRET="chaine-aleatoire-longue"

# ─── URLs publiques (pour emails d'invitation) ───────────────────────
PUBLIC_BASE_URL="https://votre-domaine.com"
SITE_URL="https://votre-domaine.com"
